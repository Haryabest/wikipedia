# Пример nginx для efiriya.ru + эфирия.рф (один сайт, admin.* на каждом домене).
# Скопировать: /etc/nginx/sites-available/efiriya
# ln -s /etc/nginx/sites-available/efiriya /etc/nginx/sites-enabled/
# certbot --nginx -d efiriya.ru -d www.efiriya.ru -d admin.efiriya.ru \
#   -d xn--h1aaxo8bq.xn--p1ai -d www.xn--h1aaxo8bq.xn--p1ai -d admin.xn--h1aaxo8bq.xn--p1ai

upstream efiteka_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name
        efiriya.ru www.efiriya.ru admin.efiriya.ru
        xn--h1aaxo8bq.xn--p1ai www.xn--h1aaxo8bq.xn--p1ai admin.xn--h1aaxo8bq.xn--p1ai;

    location / {
        proxy_pass http://efiteka_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
