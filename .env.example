DATABASE_URL="postgresql://wiki:wiki_secret@localhost:5433/wiki"
# Production: use openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
ADMIN_EMAIL="admin@example.com"
# Production: strong password, never use admin123
ADMIN_PASSWORD="change-me"
# Публичный URL (IP или домен). Для http://IP:3000 — без https
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Эфитека"
# Leave as localhost — uploads are served via /api/media (same origin, works with tunnels).
# Set a public URL only if MinIO is reachable from the browser (e.g. CDN).
MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="wiki-images"
